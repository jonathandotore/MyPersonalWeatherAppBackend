<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Alimenta os summaries dos controllers no documento OpenAPI (M5.4). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591: membro público sem XML doc — não queremos documentar tudo obrigatoriamente.
      CS1573: parâmetro sem <param> quando outros têm — documentar o CancellationToken de
              cada action seria só ruído.
      Ambos são warnings de documentação, e TreatWarningsAsErrors os tornaria bloqueantes.
    -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <UserSecretsId>weatherapp-api-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Pin transitivo. Microsoft.AspNetCore.OpenApi 10.0.10 traz Microsoft.OpenApi 2.0.0,
      afetado por CVE-2026-49451 / GHSA-v5pm-xwqc-g5wc (recursão descontrolada ao
      *parsear* documentos OpenAPI não confiáveis). Corrigido a partir da 2.7.5.
      Fixamos na MENOR versão corrigida, não na última 2.x: a
      Microsoft.AspNetCore.OpenApi 10.0.10 foi compilada contra a 2.0.0, então
      quanto menor o salto, menor o risco de divergência de API. Não subir para a
      3.x, que esta versão do ASP.NET Core não espera.
      O impacto real aqui é nulo (esta API gera documento, não parseia documento de
      terceiro), mas TreatWarningsAsErrors transforma NU1903 em erro de build e um
      restore limpo importa para quem for clonar o projeto.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeatherApp.Application\WeatherApp.Application.csproj" />
    <ProjectReference Include="..\WeatherApp.Infrastructure\WeatherApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
