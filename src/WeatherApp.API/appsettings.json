{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "WeatherAppDb": "Server=.\\SQLEXPRESS;Database=WeatherApp;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=WeatherApp"
  },
  "OpenWeatherMap": {
    "BaseUrl": "https://api.openweathermap.org/",
    "Unidades": "metric",
    "Idioma": "pt_br"
  },
  "WeatherCache": {
    "TtlClimaAtualMinutos": 10,
    "TtlPrevisaoMinutos": 15
  },
  "Jwt": {
    "Emissor": "WeatherApp.API",
    "Audiencia": "WeatherApp.Frontend",
    "MinutosExpiracao": 60
  },
  "Cors": {
    "OrigensPermitidas": [ "http://localhost:4200" ]
  }
}
